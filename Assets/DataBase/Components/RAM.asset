  ComponentName: RAM
  CompinentDescription: "\u041E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0430\u044F
    \u043F\u0430\u043C\u044F\u0442\u044C (\u041E\u0417\u0423) \u2014\u044D\u0442\u043E
    \u0434\u0435\u0442\u0430\u043B\u044C \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u043C\u0438\u043A\u0440\u043E\u0441\u0445\u0435\u043C, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F
    \u0434\u043B\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0433\u043E
    \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C
    \u0438 \u0434\u0430\u043D\u043D\u044B\u0445."
