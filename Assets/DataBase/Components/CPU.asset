  ComponentName: CPU
  CompinentDescription: "\u0426\u041F\u0423 (\u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E)
    \u2013 \u044D\u0442\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u0443\u0435\u043C\u0443\u044E
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0443 \u0434\u0430\u043D\u043D\u044B\u0445
    \u0438 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0446\u0438\u044E \u0440\u0430\u0431\u043E\u0442\u044B
    \u0435\u0433\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432.  \u0412
    \u0448\u0438\u0440\u043E\u043A\u043E\u043C \u0441\u043C\u044B\u0441\u043B\u0435
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440 \u2015 \u044D\u0442\u043E
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0438 \u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0438
    \u0441 \u0434\u0430\u043D\u043D\u044B\u043C\u0438."
