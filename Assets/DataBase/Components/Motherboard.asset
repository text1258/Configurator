  ComponentName: Motherboard
  CompinentDescription: "\u041C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u0430\u044F
    \u043F\u043B\u0430\u0442\u0430 \u2013 \u044D\u0442\u043E \u043E\u0434\u0438\u043D
    \u0438\u0437 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432
    \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0430, \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u0430\u044F,
    \u043D\u043E \u0444\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0430\u044F
    \u043E\u0441\u043D\u043E\u0432\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u0440\u0430\u0431\u043E\u0442\u0430
    \u0432\u0441\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u0421\u0432\u043E\u0435\u0433\u043E
    \u0440\u043E\u0434\u0430 \xAB\u0441\u0435\u0440\u0434\u0446\u0435\xBB \u0441\u0438\u0441\u0442\u0435\u043C\u043D\u043E\u0433\u043E
    \u0431\u043B\u043E\u043A\u0430."
